---
import Base from "../layouts/Base.astro";
import SectionHead from "../components/SectionHead.astro";
import { recruitment as r } from "../data/recruitment";
const emailLink = (subject: string) => `mailto:${r.email}?subject=${encodeURIComponent(subject)}`;
---
<Base
  title="Funded MSc & direct PhD opportunities"
  description={`Join JUST Lab at EEL-USP in Lorena, Brazil. One FAPESP-funded MSc and one Doutorado Direto fellowship in microalgae biotechnology. Apply ${r.windowLabel}.`}
>
  <section class="wrap intro" aria-labelledby="opportunities-title">
    <span class="kicker mono">Join JUST Lab · 2026</span>
    <div class="intro-grid">
      <div>
        <h1 id="opportunities-title">Small organisms.<br />Big research questions.</h1>
        <p class="lead">Funded MSc &amp; direct PhD opportunities</p>
        <p class="prose intro-copy">Help develop microalgae-based approaches to biopharmaceutical research.
          Join a growing group at the Escola de Engenharia de Lorena, University of São Paulo,
          in <strong>Lorena, São Paulo, Brazil</strong>.</p>
        <div class="actions">
          <a class="btn btn-primary" href="#positions">Find your project <span aria-hidden="true">↓</span></a>
          <a class="btn btn-ghost" href="#apply">How to apply</a>
        </div>
      </div>
      <aside class="dates card" aria-label="Application dates and funding">
        <span class="mono">Application window · one month</span>
        <dl>
          <div><dt>Opens</dt><dd><time datetime={r.opens}>{r.opensLabel}</time></dd></div>
          <div><dt>Closes</dt><dd><time datetime={r.closes}>{r.closesLabel}</time><small>{r.cutoffLabel}</small></dd></div>
          <div><dt>Online interviews</dt><dd>{r.interviewsLabel}<small>By invitation for shortlisted candidates</small></dd></div>
        </dl>
        <p class="funding-line"><strong>One MSc · One Doutorado Direto</strong><br />FAPESP Jovem Pesquisador<br />Process {r.grant}</p>
        <p class="small"><strong>Expected starts:</strong> MSc — {r.mscStartLabel}; direct PhD — {r.ddStartLabel}. Dates follow the respective PPGBI admission arrangements and fellowship activation. <a href="#admission">See admission steps below.</a></p>
      </aside>
    </div>
    <nav class="page-links" aria-label="On this page">
      <a href="#msc">Master’s project</a><a href="#dd">Direct PhD project</a>
      <a href="#support">Research environment</a><a href="#apply">Application checklist</a>
      <a href="#admission">Funding &amp; admission</a>
    </nav>
  </section>

  <section class="wrap positions" id="positions">
    <SectionHead kicker="Two complementary projects" title="Choose your next step" lead="The MSc develops screening and preliminary characterization data. The doctoral project connects scale-up and purification with detailed protein evaluation." />
    <div class="position-grid">
      <article class="position card" id="msc" aria-labelledby="msc-title">
        <span class="mono position-number">01 / Master’s fellowship</span>
        <h3 id="msc-title">From recombinant lines<br />to reliable results</h3>
        <p class="position-summary">Screening microalgae, small-scale protein production and preliminary enzyme kinetics.</p>
        <h4>Your research</h4>
        <ul>
          <li>Develop and apply screening assays to recombinant microalgal lines generated within the wider project.</li>
          <li>Compare candidate lines and select productive ones for small-scale cultivation and protein production.</li>
          <li>Measure enzyme activity and preliminary kinetic parameters, and build a reproducible dataset to inform subsequent scale-up.</li>
        </ul>
        <h4>Your preparation</h4>
        <p>A relevant undergraduate degree, completed as required for enrollment, with a foundation in microbiology and introductory molecular biology through coursework or practical training.</p>
        <p>Previous formal research experience is <strong>not required</strong>. Laboratory classes, internships, undergraduate research and relevant industry experience are valued.</p>
        <p class="project-note">Training focus: experimental design, reliable assays, careful documentation and interpretation of quantitative data.</p>
        <a class="text-link" href="#apply">Apply for the MSc <span aria-hidden="true">→</span></a>
      </article>

      <article class="position card" id="dd" aria-labelledby="dd-title">
        <span class="mono position-number">02 / Direct PhD fellowship</span>
        <h3 id="dd-title">From a bioprocess<br />to protein evaluation</h3>
        <p class="position-summary">Scale-up, purification, protein characterization and in-vitro biological evaluation.</p>
        <h4>Your research</h4>
        <ul>
          <li>Optimize cultivation and scale-up, then develop clarification, concentration, filtration and chromatographic purification.</li>
          <li>Investigate enzyme kinetics, thermal and pH stability, and structural and biochemical properties.</li>
          <li>Integrate in-vitro biological evaluation with production and characterization data, working with collaborators on specialized analyses.</li>
        </ul>
        <h4>Your preparation</h4>
        <p>Relevant practical experience and evidence that you can plan, execute, document and troubleshoot experiments with increasing independence.</p>
        <p>The approved category is <strong>Doutorado Direto (DD)</strong>, for applicants <strong>without a Master’s degree</strong>. You must meet the graduate program’s direct-PhD admission requirements.</p>
        <p class="project-note">Experience with recombinant proteins, microbiology, molecular biology, purification or bioprocesses is valuable. Publications are welcome, but not mandatory.</p>
        <a class="text-link" href="#apply">Apply for the direct PhD <span aria-hidden="true">→</span></a>
      </article>
    </div>
    <div class="shared">
      <p><strong>Previous microalgae experience is not required for either position.</strong>
        You do not need to know every technique before joining.</p>
      <p>Relevant backgrounds include biology, biotechnology, biochemistry, pharmacy, microbiology,
        bioengineering, chemical or biochemical engineering, and related fields. We welcome candidates
        from Brazil and abroad, including those with academic, technical or industry experience.</p>
    </div>
  </section>

  <section class="environment" id="support">
    <div class="wrap environment-grid">
      <SectionHead kicker="A growing group at USP" title="Build your research with support" />
      <div class="support-copy">
        <p>You will help establish methods and workflows in a new lab, with access to infrastructure through EEL-USP, other USP facilities and collaborating laboratories.</p>
        <ul>
          <li>Frequent individual supervision and growing experimental independence.</li>
          <li>Training in scientific writing, presentations and fellowship or grant preparation.</li>
          <li>Opportunities to mentor undergraduates and contribute to collaborative research.</li>
          <li>Preparation for careers in academia, biotechnology and biopharmaceutical R&amp;D.</li>
        </ul>
        <p>International collaborations and research visits may be pursued when suitable, subject to opportunities, eligibility and approval.</p>
      </div>
    </div>
  </section>

  <section class="wrap apply" id="apply" aria-labelledby="apply-title">
    <SectionHead kicker="Apply by email" title="Tell us what you want to explore" lead={`Send your application to ${r.email} between ${r.opensLabel} and ${r.closesLabel}. The deadline is ${r.cutoffLabel} on ${r.closesLabel}.`} />
    <div class="apply-grid">
      <div>
        <h3 id="apply-title">Your application checklist</h3>
        <ol class="checklist">
          <li><strong>CV or Currículo Lattes</strong><span>Include relevant coursework, laboratory, research, internship or professional experience.</span></li>
          <li><strong>One-page motivation statement</strong><span>Describe your interests, relevant preparation, why this project appeals to you and your availability to start.</span></li>
        </ol>
        <p class="small">Prepare your CV and motivation statement in English. If using a Portuguese Lattes profile, summarize your relevant experience in English in the statement. Formal graduate-admission documents follow the program’s requirements.</p>
        <p class="small">DD applicants may also include links to research outputs, a thesis, publications or preprints, when available. Publications are not mandatory.</p>
      </div>
      <aside class="email-panel card" aria-label="Email and required subjects">
        <span class="mono">Application address</span>
        <a class="email" href={`mailto:${r.email}`}>{r.email}</a>
        <p>Use the subject for your chosen position. Replace <strong>Full Name</strong> with your name.</p>
        <div class="subject">
          <span class="mono">Master’s</span>
          <code>{r.mscSubject}</code>
          <a href={emailLink(r.mscSubject)}>Start MSc email <span aria-hidden="true">↗</span></a>
        </div>
        <div class="subject">
          <span class="mono">Direct PhD · DD</span>
          <code>{r.ddSubject}</code>
          <a href={emailLink(r.ddSubject)}>Start DD email <span aria-hidden="true">↗</span></a>
        </div>
        <p class="small">Attach your documents before sending. You can also copy the address and subject into your preferred email service.</p>
      </aside>
    </div>
  </section>

  <section class="wrap admission" id="admission">
    <SectionHead kicker="What happens next" title="Selection, funding & admission" />
    <div class="details-grid">
      <div>
        <h3>Selection by the lab</h3>
        <p>Applications will be assessed for motivation, scientific fit, relevant preparation and potential to develop. For the DD, we also consider experimental maturity and evidence of independence.</p>
        <p>Shortlisted applicants will be invited to book an <strong>online interview for {r.interviewsLabel}</strong>, including a brief presentation (in English for DD). MSc applicants can discuss coursework, internships, technical or professional experience if they have not conducted formal research.</p>
        <p>We aim to complete lab selection by the end of 2026. Start arrangements differ between MSc and direct PhD and will be discussed at interview, subject to the respective PPGBI admission calendar and fellowship activation.</p>
      </div>
      <div>
        <h3>FAPESP support</h3>
        <p>Both fellowships are approved within FAPESP Jovem Pesquisador grant <strong>{r.grant}</strong>. Stipends follow the applicable <a href="https://fapesp.br/valores/bolsasnopais">FAPESP fellowship table</a>, with Technical Reserve for eligible research expenses. USP charges no tuition fees for these graduate degrees.</p>
        <p>Fellowships require dedication to the degree and research under FAPESP rules. Any employment or other funding must comply with the applicable conditions.</p>
        <p><a href="https://fapesp.br/bolsas/ms">MSc fellowship rules ↗</a><br /><a href="https://fapesp.br/bolsas/dd">Direct PhD fellowship rules ↗</a></p>
      </div>
    </div>
    <div class="admission-note">
      <h3>Graduate admission through PPGBI</h3>
      <p>Both positions are linked to the <a href="https://sites.usp.br/ppgbi/">Programa de Pós-Graduação em Biotecnologia Industrial (PPGBI)</a> at EEL-USP.
        Selection by JUST Lab does not replace formal program admission or FAPESP fellowship activation.
        Program applications have their own deadlines; do not wait for the lab selection result to prepare your documents.</p>
      <h4>Master’s: apply to the current admission process</h4>
      <p>Applicants must also participate in <a href={r.mscAdmissionNoticeUrl}>Edital PPGBI 03/2026</a>, with a separate application to <a href="mailto:ppgbi@eel.usp.br">ppgbi@eel.usp.br</a> by <strong>{r.mscAdmissionDeadlineLabel}</strong>. The lab application does not register you for the program. Consult the notice for the full document checklist and selection procedure.</p>
      <p><strong>Expected start: {r.mscStartLabel}</strong>, subject to the PPGBI admission calendar and fellowship activation.</p>
      <h4>Direct PhD: forthcoming admission call</h4>
      <p>The next rolling-admission call is expected in late November 2026. Follow the <a href="https://cpg.eel.usp.br/apoio-administrativo/editais-de-selecao">official admissions notices</a> for confirmation and the applicable DD procedure. This refers to graduate admission; the lab application deadline remains {r.closesLabel}.</p>
      <p><strong>Start: {r.ddStartLabel}</strong>, with later dates available through rolling PPGBI admission, subject to the forthcoming notice and fellowship activation. The individual start date will be agreed at interview.</p>
      <p>Day-to-day communication can take place in Portuguese and/or English. Formal language-proficiency and enrollment requirements follow the graduate program’s rules.</p>
    </div>
    <p class="questions">Questions about fit or the application? <a href={`mailto:${r.email}`}>Contact João Vitor Dutra Molino</a>.</p>
  </section>
</Base>

<style>
  .intro { padding-block: clamp(3rem, 7vw, 5.5rem) 0; }
  .intro-grid { display: grid; grid-template-columns: 1.5fr 1fr; gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  h1 { font-size: clamp(2.6rem, 5.5vw, 4.5rem); max-width: 17ch; line-height: 1.06; }
  .lead { font-size: clamp(1.2rem, 2.2vw, 1.55rem); font-weight: 500; color: var(--accent); margin: 1.4rem 0 .8rem; }
  .intro-copy { color: var(--ink-soft); }
  .actions { display: flex; gap: .7rem; flex-wrap: wrap; margin-top: 1.6rem; }
  .dates { background: var(--surface-2); padding: clamp(1.4rem, 3vw, 2rem); border-top: 3px solid var(--accent); }
  .dates > .mono { color: var(--accent); }
  dl { margin: 1.3rem 0; }
  dl > div { padding-block: .7rem; border-bottom: 1px solid var(--line); }
  dt { color: var(--ink-soft); font-size: .85rem; }
  dd { margin: .2rem 0 0; font-family: var(--font-display); font-size: 1.45rem; font-weight: 600; line-height: 1.35; }
  dd small { display: block; font-family: var(--font-body); font-size: .8rem; font-weight: 400; color: var(--ink-soft); margin-top: .3rem; }
  .funding-line { font-size: .9rem; }
  .small { font-size: .88rem; color: var(--ink-soft); }
  .dates p:last-child { margin-bottom: 0; }
  .page-links { display: flex; flex-wrap: wrap; gap: .7rem 1.5rem; border-block: 1px solid var(--line); padding-block: 1rem; margin-top: 3rem; font-size: .88rem; }
  .positions, .apply, .admission { padding-block: clamp(3rem, 7vw, 5rem); }
  .position-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.3rem; margin-top: 2rem; }
  .position { padding: clamp(1.4rem, 3vw, 2rem); display: flex; flex-direction: column; }
  .position-number { color: var(--accent); margin-bottom: 1.2rem; }
  .position h3 { font-size: clamp(1.7rem, 3vw, 2.25rem); }
  .position-summary { margin: 1.2rem 0 .4rem; color: var(--accent); }
  h4 { font-family: var(--font-body); font-size: 1rem; margin-block: 1.4rem .7rem; }
  .position p, .position li, .support-copy { color: var(--ink-soft); }
  .position p, .position li { font-size: .96rem; }
  ul { padding-left: 1.2rem; margin: 0; }
  li + li { margin-top: .65rem; }
  .project-note { border-top: 1px solid var(--line); padding-top: 1rem; margin-top: .3rem; }
  .text-link { margin-top: auto; padding-top: .7rem; font-weight: 500; }
  .shared { margin-top: 1.5rem; padding: 1.4rem 1.6rem; background: var(--accent-soft); border-radius: var(--radius); }
  .shared p:last-child { margin: 0; font-size: .95rem; color: var(--ink-soft); }
  .environment { background: var(--surface-2); border-block: 1px solid var(--line); padding-block: clamp(3rem, 6vw, 4rem); }
  .environment-grid { display: grid; grid-template-columns: 1fr 1.25fr; gap: 3rem; }
  .support-copy ul { margin-block: 1rem; }
  .apply-grid { display: grid; grid-template-columns: 1.1fr 1fr; gap: 3rem; margin-top: 2rem; align-items: start; }
  .apply h3, .admission h3 { font-size: 1.4rem; margin-bottom: 1rem; }
  .checklist { padding-left: 1.3rem; margin: 1.3rem 0; }
  .checklist li { padding-left: .3rem; }
  .checklist li::marker { color: var(--accent); font-weight: 600; }
  .checklist span { display: block; color: var(--ink-soft); font-size: .95rem; margin-top: .25rem; }
  .email-panel { background: var(--surface-2); padding: clamp(1.3rem, 3vw, 2rem); }
  .email-panel > .mono { color: var(--accent); }
  .email { display: block; font-family: var(--font-display); font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 600; margin: .5rem 0 1rem; overflow-wrap: anywhere; }
  .email-panel p { color: var(--ink-soft); font-size: .92rem; }
  .subject { border-top: 1px solid var(--line); padding-block: 1rem; }
  .subject .mono { color: var(--ink-soft); }
  code { display: block; font-family: var(--font-mono); font-size: .86rem; overflow-wrap: anywhere; margin: .5rem 0; }
  .subject a { font-size: .88rem; }
  .email-panel p:last-child { margin-bottom: 0; }
  .admission { border-top: 1px solid var(--line); }
  .details-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; margin-top: 2rem; }
  .details-grid p, .admission-note p { color: var(--ink-soft); font-size: .96rem; }
  .admission-note { background: var(--accent-soft); padding: 1.6rem; border-radius: var(--radius); margin-top: 1.4rem; }
  .admission-note p:last-child { margin: 0; }
  .questions { margin: 1.5rem 0 0; font-size: .95rem; }
  [id] { scroll-margin-top: 6rem; }
  @media (max-width: 820px) {
    .intro-grid, .position-grid, .environment-grid, .apply-grid, .details-grid { grid-template-columns: 1fr; gap: 1.5rem; }
    .intro h1 { max-width: 18ch; }
    .dates { max-width: none; }
    .page-links { margin-top: 2rem; }
  }
  @media print {
    .actions, .page-links { display: none; }
    .intro, .positions, .environment, .apply, .admission { padding-block: 1.5rem; }
    .position, .dates, .email-panel { break-inside: avoid; }
  }
</style>
