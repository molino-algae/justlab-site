---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import SectionHead from "../components/SectionHead.astro";
import HardwareCard from "../components/HardwareCard.astro";
import { href } from "../lib/url";
import { protocols } from "../lib/data";

const protocolCount = protocols.reduce((n, g) => n + g.items.length, 0);

const hardware = (await getCollection("hardware")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Base
  title="Resources"
  description="Protocols, open hardware, datasets, and code from the JUST Lab."
>
  <section class="wrap">
    <SectionHead
      kicker="Resources"
      title="Open protocols, hardware, data, and code"
      lead="The JUST Lab shares its methods and tools openly. Open hardware and protocols are online now; datasets and code will be added as they are released."
    />
  </section>

  <section class="wrap">
    <h2 class="hw-h">Open hardware</h2>
    <p class="hw-lead">
      Seven projects — photobioreactors, light control, sensors and a 3D-printed
      centrifuge — designed and documented openly, each stating what it has not yet
      measured.
      <a href={href("/resources/hardware/")}>See all open hardware →</a>
    </p>
    <div class="hw-grid">
      {hardware.map((item) => <HardwareCard item={item} />)}
    </div>
  </section>

  <section class="wrap">
    <div class="grid">
      <a class="card link" href={href("/resources/protocols/")}>
        <h3>Protocols</h3>
        <p>
          Step-by-step methods for culturing, transformation, screening, and
          plastic-degrading enzyme assays — {protocolCount} published on protocols.io.
        </p>
        <span class="go">Browse protocols →</span>
      </a>
    </div>
  </section>
</Base>

<style>
  .hw-h {
    font-size: 1.4rem;
  }
  .hw-lead {
    color: var(--ink-soft);
    max-width: 62ch;
    margin-top: 0.6rem;
  }
  .hw-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.2rem;
    margin-top: 1.6rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.2rem;
  }
  .card h3 {
    font-size: 1.1rem;
    margin-bottom: 0.5rem;
  }
  .card p {
    color: var(--ink-soft);
    font-size: 0.92rem;
  }
  .card.link {
    display: block;
    text-decoration: none;
    color: inherit;
    transition:
      transform 0.2s var(--ease),
      border-color 0.2s;
  }
  .card.link:hover,
  .card.link:focus-visible {
    transform: translateY(-3px);
    border-color: var(--accent);
  }
  .go {
    color: var(--accent);
    font-size: 0.9rem;
  }
</style>
