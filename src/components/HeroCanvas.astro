---
import { site } from "../lib/data";
interface Props {
  lede?: string;
}
const { lede = site.description } = Astro.props;
---

<header class="hero" id="top">
  <canvas id="hero-canvas" aria-hidden="true"></canvas>
  <div class="hero-inner wrap">
    <span class="eyebrow mono">{site.institution}</span>
    <h1>{site.tagline}.</h1>
    <p class="lede">{lede}</p>
    <p class="acro mono">{site.acronym}</p>
    <div class="hero-cta">
      <a class="btn btn-primary" href="/research">Explore the research</a>
      <a class="btn btn-ghost" href="/contact">Work with us</a>
    </div>
  </div>
  <button class="replay mono" id="hero-replay" type="button">Replay ↻</button>
  <div class="scrollcue mono" aria-hidden="true"><span>scroll</span><i></i></div>
</header>

<script>
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const cv = document.getElementById("hero-canvas") as HTMLCanvasElement | null;
  const ctx = cv?.getContext("2d") ?? null;
  const PART = "#55ecac";
  let W = 0,
    H = 0,
    DPR = 1,
    running = false;
  let particles: any[] = [],
    cells: any[] = [],
    bubbles: any[] = [];

  function size() {
    if (!cv || !ctx) return;
    DPR = Math.min(devicePixelRatio || 1, 2);
    const r = cv.getBoundingClientRect();
    W = Math.max(1, r.width);
    H = Math.max(1, r.height);
    cv.width = W * DPR;
    cv.height = H * DPR;
    ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
  }

  function sampleWord(scatter: boolean) {
    if (!cv) return;
    const off = document.createElement("canvas");
    off.width = W;
    off.height = H;
    const oc = off.getContext("2d");
    if (!oc) return;
    const fs = Math.max(46, Math.min(W * 0.15, 168));
    oc.font = `700 ${fs}px "Fraunces", Georgia, serif`;
    oc.textAlign = "center";
    oc.textBaseline = "middle";
    oc.fillStyle = "#fff";
    oc.fillText("JUSTLAB", W / 2, H * 0.44);
    let data: Uint8ClampedArray;
    try {
      data = oc.getImageData(0, 0, W, H).data;
    } catch (e) {
      return;
    }
    const step = Math.max(4, Math.round(W / 300));
    const pts: number[][] = [];
    for (let y = 0; y < H; y += step)
      for (let x = 0; x < W; x += step)
        if (data[(y * W + x) * 4 + 3] > 130) pts.push([x, y]);
    for (let i = pts.length - 1; i > 0; i--) {
      const j = (Math.random() * (i + 1)) | 0;
      [pts[i], pts[j]] = [pts[j], pts[i]];
    }
    if (pts.length > 1900) pts.length = 1900;
    particles = pts.map((p) => {
      const a = Math.random() * Math.PI * 2;
      const rad = scatter ? 60 + Math.random() * 260 : 24 + Math.random() * 90;
      return {
        hx: p[0],
        hy: p[1],
        cx: p[0] + Math.cos(a) * rad,
        cy: p[1] + Math.sin(a) * rad,
        r: step * 0.42 * (0.7 + Math.random() * 0.7),
        ph: Math.random() * Math.PI * 2,
        sp: 0.5 + Math.random() * 0.9,
      };
    });
  }

  function initAmbient() {
    cells = [];
    for (let i = 0; i < Math.round(W / 46); i++)
      cells.push({
        x: Math.random() * W,
        y: Math.random() * H,
        r: 3 + Math.random() * 9,
        vx: (Math.random() - 0.5) * 0.16,
        vy: (Math.random() - 0.5) * 0.16,
        a: 0.05 + Math.random() * 0.09,
      });
    bubbles = [];
    for (let b = 0; b < 16; b++)
      bubbles.push({
        x: W * (0.04 + Math.random() * 0.06),
        y: Math.random() * H,
        r: 1.4 + Math.random() * 3,
        v: 0.3 + Math.random() * 0.8,
      });
  }

  function draw(t: number) {
    if (!ctx) return;
    ctx.clearRect(0, 0, W, H);
    for (const c of cells) {
      c.x += c.vx;
      c.y += c.vy;
      if (c.x < -20) c.x = W + 20;
      if (c.x > W + 20) c.x = -20;
      if (c.y < -20) c.y = H + 20;
      if (c.y > H + 20) c.y = -20;
      ctx.beginPath();
      ctx.fillStyle = `rgba(90,235,175,${c.a})`;
      ctx.arc(c.x, c.y, c.r, 0, 6.2832);
      ctx.fill();
    }
    for (const bu of bubbles) {
      bu.y -= bu.v;
      bu.x += Math.sin(bu.y * 0.03) * 0.25;
      if (bu.y < -10) {
        bu.y = H + 10;
        bu.x = W * (0.04 + Math.random() * 0.06);
      }
      ctx.beginPath();
      ctx.fillStyle = "rgba(180,255,225,0.28)";
      ctx.arc(bu.x, bu.y, bu.r, 0, 6.2832);
      ctx.fill();
    }
    ctx.fillStyle = PART;
    for (const p of particles) {
      p.cx += (p.hx - p.cx) * 0.075;
      p.cy += (p.hy - p.cy) * 0.075;
      const settled = Math.abs(p.hx - p.cx) < 1.2;
      const bob = settled ? Math.sin(t * 0.001 * p.sp + p.ph) * 0.7 : 0;
      ctx.globalAlpha = settled ? 0.9 : 0.6;
      ctx.beginPath();
      ctx.arc(p.cx, p.cy + bob, p.r, 0, 6.2832);
      ctx.fill();
    }
    ctx.globalAlpha = 1;
  }

  function loop(t: number) {
    draw(t);
    if (running) requestAnimationFrame(loop);
  }

  function boot() {
    if (!cv) return;
    size();
    initAmbient();
    sampleWord(false);
    if (reduce) {
      draw(0);
      return;
    }
    if (!running) {
      running = true;
      requestAnimationFrame(loop);
    }
  }

  if (cv) {
    if (document.fonts?.ready) document.fonts.ready.then(boot);
    else addEventListener("load", boot);

    let rt: any;
    addEventListener("resize", () => {
      clearTimeout(rt);
      rt = setTimeout(() => {
        size();
        initAmbient();
        sampleWord(false);
        if (reduce) draw(0);
      }, 200);
    });

    document.getElementById("hero-replay")?.addEventListener("click", () => {
      sampleWord(true);
      if (reduce) {
        draw(0);
        return;
      }
      if (!running) {
        running = true;
        requestAnimationFrame(loop);
      }
    });
  }
</script>

<style>
  .hero {
    position: relative;
    background: var(--hero-bg);
    color: var(--hero-ink);
    overflow: hidden;
    isolation: isolate;
    min-height: clamp(560px, 88vh, 800px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: 64px;
  }
  .hero::before {
    content: "";
    position: absolute;
    inset: -20%;
    z-index: 0;
    background:
      radial-gradient(38% 40% at 22% 30%, rgba(28, 125, 85, 0.55), transparent 70%),
      radial-gradient(32% 38% at 78% 66%, rgba(20, 92, 66, 0.55), transparent 70%),
      radial-gradient(30% 30% at 60% 20%, rgba(60, 200, 150, 0.28), transparent 70%);
    filter: blur(60px);
    animation: mesh 26s var(--ease) infinite alternate;
  }
  @keyframes mesh {
    from {
      transform: translate3d(-3%, -2%, 0) scale(1);
    }
    to {
      transform: translate3d(4%, 3%, 0) scale(1.15);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero::before {
      animation: none;
    }
  }

  #hero-canvas {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    display: block;
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    padding-block: 3rem 3.5rem;
  }
  .eyebrow {
    color: var(--hero-mono);
    display: block;
    margin-bottom: 1.4rem;
  }
  .hero h1 {
    font-size: clamp(2.6rem, 7.5vw, 5.4rem);
    max-width: 15ch;
  }
  .lede {
    color: var(--hero-soft);
    font-size: clamp(1.05rem, 2vw, 1.3rem);
    max-width: 46ch;
    margin-top: 1.4rem;
  }
  .acro {
    color: var(--hero-mono);
    margin-top: 1rem;
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2rem;
  }
  .hero .btn-primary {
    background: var(--hero-particle);
    color: #05130d;
  }
  .hero .btn-ghost {
    border-color: rgba(159, 220, 196, 0.4);
    color: var(--hero-ink);
  }

  .replay {
    position: absolute;
    right: var(--pad);
    bottom: 6.5rem;
    z-index: 2;
    background: transparent;
    border: 1px solid rgba(159, 220, 196, 0.35);
    color: var(--hero-soft);
    border-radius: 999px;
    padding: 0.35rem 0.9rem;
    cursor: pointer;
  }
  .replay:hover {
    color: var(--hero-ink);
    border-color: var(--hero-particle);
  }

  .scrollcue {
    position: absolute;
    left: 50%;
    bottom: 1.6rem;
    transform: translateX(-50%);
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    color: var(--hero-mono);
  }
  .scrollcue i {
    width: 1px;
    height: 34px;
    background: linear-gradient(var(--hero-mono), transparent);
    animation: cue 2s var(--ease) infinite;
  }
  @keyframes cue {
    0% {
      transform: scaleY(0);
      transform-origin: top;
    }
    45% {
      transform: scaleY(1);
      transform-origin: top;
    }
    55% {
      transform: scaleY(1);
      transform-origin: bottom;
    }
    100% {
      transform: scaleY(0);
      transform-origin: bottom;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .scrollcue i {
      animation: none;
    }
  }
</style>
