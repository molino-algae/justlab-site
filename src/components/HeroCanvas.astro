---
import { site } from "../lib/data";
import { href } from "../lib/url";
interface Props {
  lede?: string;
}
const { lede = site.description } = Astro.props;
---

<header class="hero" id="top">
  <canvas id="hero-canvas" aria-hidden="true"></canvas>
  <div class="hero-inner wrap">
    <span class="eyebrow mono">{site.institution}</span>
    <div class="word-space" aria-hidden="true"></div>
    <h1>{site.tagline}.</h1>
    <p class="lede">{lede}</p>
    <p class="acro mono">{site.acronym}</p>
    <div class="hero-cta">
      <a class="btn btn-primary" href={href("/research")}>Explore the research</a>
      <a class="btn btn-ghost" href={href("/contact")}>Work with us</a>
    </div>
  </div>
  <button class="replay mono" id="hero-replay" type="button">Replay ↻</button>
  <div class="scrollcue mono" aria-hidden="true"><span>scroll</span><i></i></div>
</header>

<script>
  /**
   * Phototaxis hero: microalgae cells swim in from the edges toward a light and
   * accumulate into the wordmark "JUSTLAB". Rendered with additive blending, so
   * what you see is density concentrating — the cells getting together — not
   * individual dots. After forming they keep milling, so the word stays alive.
   * (Based on the lab's real phototaxis shape-forming experiment.)
   */
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const cv = document.getElementById("hero-canvas") as HTMLCanvasElement | null;
  const ctx = cv?.getContext("2d") ?? null;

  const GREEN = "90,235,175";
  let W = 0,
    H = 0,
    DPR = 1,
    wordY = 0,
    running = false,
    raf = 0;

  type Cell = {
    x: number;
    y: number;
    vx: number;
    vy: number;
    tx: number;
    ty: number;
    ph: number;
    spd: number;
    amb: boolean;
    loose: boolean;
  };
  let cells: Cell[] = [];
  let bubbles: { x: number; y: number; r: number; v: number }[] = [];

  function size() {
    if (!cv || !ctx) return;
    DPR = Math.min(devicePixelRatio || 1, 2);
    const r = cv.getBoundingClientRect();
    W = Math.max(1, Math.round(r.width));
    H = Math.max(1, Math.round(r.height));
    wordY = H * 0.34;
    cv.width = W * DPR;
    cv.height = H * DPR;
    ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
  }

  function wordTargets(): { x: number; y: number }[] {
    const off = document.createElement("canvas");
    off.width = W;
    off.height = H;
    const oc = off.getContext("2d", { willReadFrequently: true });
    if (!oc) return [];
    const fs = Math.max(60, Math.min(W * 0.2, 270));
    oc.font = `700 ${fs}px "Fraunces", Georgia, serif`;
    oc.textAlign = "center";
    oc.textBaseline = "middle";
    oc.fillStyle = "#fff";
    oc.fillText("JUSTLAB", Math.round(W / 2), Math.round(wordY));
    let data: Uint8ClampedArray;
    try {
      data = oc.getImageData(0, 0, W, H).data;
    } catch {
      return [];
    }
    const step = Math.max(2, Math.round(W / 620));
    const pts: { x: number; y: number }[] = [];
    for (let y = 0; y < H; y += step)
      for (let x = 0; x < W; x += step)
        if (data[(y * W + x) * 4 + 3] > 140) pts.push({ x, y });
    return pts;
  }

  function edgePoint(): { x: number; y: number } {
    const s = Math.random() * 4;
    if (s < 1) return { x: Math.random() * W, y: -30 };
    if (s < 2) return { x: Math.random() * W, y: H + 30 };
    if (s < 3) return { x: -30, y: Math.random() * H };
    return { x: W + 30, y: Math.random() * H };
  }

  function seed(scatter: boolean) {
    const targets = wordTargets();
    const WORD = Math.min(targets.length, Math.round((W * H) / 85));
    const AMB = Math.round(W / 24);
    cells = [];
    for (let i = 0; i < WORD; i++) {
      const t = targets[(Math.random() * targets.length) | 0];
      const start = scatter
        ? edgePoint()
        : { x: t.x + (Math.random() - 0.5) * 16, y: t.y + (Math.random() - 0.5) * 16 };
      cells.push({
        x: start.x,
        y: start.y,
        vx: 0,
        vy: 0,
        tx: t.x + (Math.random() - 0.5) * 2,
        ty: t.y + (Math.random() - 0.5) * 2,
        ph: Math.random() * 6.28,
        spd: 0.7 + Math.random() * 0.6,
        amb: false,
        // ~12% stay a touch restless so the formed word still breathes
        loose: Math.random() < 0.12,
      });
    }
    for (let i = 0; i < AMB; i++) {
      cells.push({
        x: Math.random() * W,
        y: Math.random() * H,
        vx: (Math.random() - 0.5) * 0.3,
        vy: (Math.random() - 0.5) * 0.3,
        tx: 0,
        ty: 0,
        ph: Math.random() * 6.28,
        spd: 1,
        amb: true,
        loose: false,
      });
    }
    // rising bubble column on the left — the photobioreactor nod
    bubbles = Array.from({ length: 20 }, () => ({
      x: W * (0.02 + Math.random() * 0.08),
      y: Math.random() * H,
      r: 1.2 + Math.random() * 3.2,
      v: 0.3 + Math.random() * 0.95,
    }));
  }

  function step(t: number) {
    for (const c of cells) {
      if (c.amb) {
        c.x += c.vx;
        c.y += c.vy;
        if (c.x < -20) c.x = W + 20;
        if (c.x > W + 20) c.x = -20;
        if (c.y < -20) c.y = H + 20;
        if (c.y > H + 20) c.y = -20;
        continue;
      }
      const dx = c.tx - c.x;
      const dy = c.ty - c.y;
      const d = Math.hypot(dx, dy) || 1;
      const near = d < 22;
      // phototaxis: steer hard toward the target light, then lock on tight
      const steer = near ? 0.16 : 0.08;
      c.vx += (dx / d) * steer * c.spd;
      c.vy += (dy / d) * steer * c.spd;
      // run-and-tumble noise: strong in transit, almost nothing once arrived
      const tumble = near ? (c.loose ? 0.05 : 0.012) : 0.24;
      c.vx += (Math.random() - 0.5) * tumble;
      c.vy += (Math.random() - 0.5) * tumble;
      c.vx *= near ? 0.72 : 0.89;
      c.vy *= near ? 0.72 : 0.89;
      const bob = near && c.loose ? Math.sin(t * 0.001 * c.spd + c.ph) * 0.18 : 0;
      c.x += c.vx + bob;
      c.y += c.vy;
    }
    for (const b of bubbles) {
      b.y -= b.v;
      b.x += Math.sin(b.y * 0.03) * 0.22;
      if (b.y < -12) {
        b.y = H + 12;
        b.x = W * (0.02 + Math.random() * 0.08);
      }
    }
  }

  function paint() {
    if (!ctx) return;
    ctx.clearRect(0, 0, W, H);
    // the light the cells swim toward
    const g = ctx.createRadialGradient(W / 2, wordY, 0, W / 2, wordY, W * 0.42);
    g.addColorStop(0, `rgba(${GREEN},0.09)`);
    g.addColorStop(1, "rgba(0,0,0,0)");
    ctx.fillStyle = g;
    ctx.fillRect(0, 0, W, H);

    // cells — additive, so overlap reads as accumulating density
    ctx.globalCompositeOperation = "lighter";
    for (const c of cells) {
      ctx.beginPath();
      ctx.fillStyle = c.amb ? `rgba(${GREEN},0.04)` : `rgba(${GREEN},0.14)`;
      ctx.arc(c.x, c.y, c.amb ? 5 : 1.8, 0, 6.2832);
      ctx.fill();
    }
    ctx.globalCompositeOperation = "source-over";

    // bubbles
    for (const b of bubbles) {
      ctx.beginPath();
      ctx.fillStyle = "rgba(184,255,228,0.32)";
      ctx.arc(b.x, b.y, b.r, 0, 6.2832);
      ctx.fill();
    }
  }

  function forming(): boolean {
    for (const c of cells)
      if (!c.amb && (c.tx - c.x) ** 2 + (c.ty - c.y) ** 2 > 160) return true;
    return false;
  }

  function loop(t: number) {
    // run the simulation 2x per frame while the word is still coming together,
    // so it forms in about half the time; back to real-time once it is milling.
    const sub = forming() ? 2 : 1;
    for (let i = 0; i < sub; i++) step(t + i * 6);
    paint();
    if (running) raf = requestAnimationFrame(loop);
  }

  function start(scatter: boolean) {
    if (!cv || !ctx) return;
    seed(scatter);
    cancelAnimationFrame(raf);
    running = false;

    // Always render a settled frame synchronously first, so the hero is never
    // blank — for reduced-motion, fast scrollers, and any context where
    // requestAnimationFrame is throttled (hidden tab, thumbnail).
    if (!scatter || reduce) {
      for (let i = 0; i < 90; i++) step(i * 16);
      paint();
      if (reduce) return;
    }

    running = true;
    raf = requestAnimationFrame(loop);
  }

  function boot() {
    size();
    // page load: cells start near the word so it's readable at once, then mill.
    // the full "swim in from the edges" plays on the Replay button.
    start(false);
  }

  if (cv) {
    if (document.fonts?.ready) document.fonts.ready.then(boot);
    else addEventListener("load", boot);

    let rt: ReturnType<typeof setTimeout>;
    addEventListener("resize", () => {
      clearTimeout(rt);
      rt = setTimeout(() => {
        size();
        start(false);
      }, 200);
    });
    document
      .getElementById("hero-replay")
      ?.addEventListener("click", () => start(true));
  }
</script>

<style>
  .hero {
    position: relative;
    background: var(--hero-bg);
    color: var(--hero-ink);
    overflow: hidden;
    isolation: isolate;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: 64px;
  }
  .hero::before {
    content: "";
    position: absolute;
    inset: -20%;
    z-index: 0;
    background:
      radial-gradient(38% 40% at 22% 34%, rgba(28, 125, 85, 0.42), transparent 70%),
      radial-gradient(34% 40% at 80% 70%, rgba(20, 92, 66, 0.42), transparent 70%);
    filter: blur(70px);
    animation: mesh 30s var(--ease) infinite alternate;
  }
  @keyframes mesh {
    from {
      transform: translate3d(-3%, -2%, 0) scale(1);
    }
    to {
      transform: translate3d(3%, 3%, 0) scale(1.12);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero::before {
      animation: none;
    }
  }

  #hero-canvas {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    display: block;
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    padding-block: 2rem 3rem;
  }
  /* reserves the vertical band where the wordmark forms on the canvas */
  .word-space {
    height: clamp(150px, 30vh, 320px);
  }
  .eyebrow {
    color: var(--hero-mono);
    display: block;
  }
  .hero h1 {
    font-size: clamp(1.9rem, 4.6vw, 3.3rem);
    max-width: 15ch;
  }
  .lede {
    color: var(--hero-soft);
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    max-width: 46ch;
    margin-top: 1.3rem;
  }
  .acro {
    color: var(--hero-mono);
    margin-top: 1rem;
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2rem;
  }
  .hero .btn-primary {
    background: var(--hero-particle);
    color: #05130d;
  }
  .hero .btn-ghost {
    border-color: rgba(159, 220, 196, 0.4);
    color: var(--hero-ink);
  }

  .replay {
    position: absolute;
    right: var(--pad);
    bottom: 1.4rem;
    z-index: 2;
    background: transparent;
    border: 1px solid rgba(159, 220, 196, 0.35);
    color: var(--hero-soft);
    border-radius: 999px;
    padding: 0.35rem 0.9rem;
    cursor: pointer;
  }
  .replay:hover {
    color: var(--hero-ink);
    border-color: var(--hero-particle);
  }

  .scrollcue {
    position: absolute;
    left: 50%;
    bottom: 1.6rem;
    transform: translateX(-50%);
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    color: var(--hero-mono);
  }
  .scrollcue i {
    width: 1px;
    height: 34px;
    background: linear-gradient(var(--hero-mono), transparent);
    animation: cue 2s var(--ease) infinite;
  }
  @keyframes cue {
    0% {
      transform: scaleY(0);
      transform-origin: top;
    }
    45%,
    55% {
      transform: scaleY(1);
    }
    55% {
      transform-origin: bottom;
    }
    100% {
      transform: scaleY(0);
      transform-origin: bottom;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .scrollcue i {
      animation: none;
    }
    .replay {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .word-space {
      height: 16vh;
    }
  }
</style>
