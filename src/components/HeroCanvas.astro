---
import { site } from "../lib/data";
interface Props {
  lede?: string;
}
const { lede = site.description } = Astro.props;
---

<header class="hero" id="top">
  <canvas id="hero-canvas" aria-hidden="true"></canvas>
  <div class="hero-inner wrap">
    <span class="eyebrow mono">{site.institution}</span>
    <h1>{site.tagline}.</h1>
    <p class="lede">{lede}</p>
    <p class="acro mono">{site.acronym}</p>
    <div class="hero-cta">
      <a class="btn btn-primary" href="/research">Explore the research</a>
      <a class="btn btn-ghost" href="/contact">Work with us</a>
    </div>
  </div>
  <div class="scrollcue mono" aria-hidden="true"><span>scroll</span><i></i></div>
</header>

<script>
  // Ambient "culture under the light": drifting cells, a rising bubble column,
  // faint links between close cells. Degrades to a single static frame under
  // prefers-reduced-motion.
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const cv = document.getElementById("hero-canvas") as HTMLCanvasElement | null;
  const ctx = cv?.getContext("2d") ?? null;

  let W = 0,
    H = 0,
    DPR = 1,
    running = false;
  let cells: { x: number; y: number; vx: number; vy: number; r: number; a: number }[] = [];
  let bubbles: { x: number; y: number; r: number; v: number }[] = [];

  function size() {
    if (!cv || !ctx) return;
    DPR = Math.min(devicePixelRatio || 1, 2);
    const r = cv.getBoundingClientRect();
    W = Math.max(1, Math.round(r.width));
    H = Math.max(1, Math.round(r.height));
    cv.width = W * DPR;
    cv.height = H * DPR;
    ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
  }

  function seed() {
    const n = Math.round((W * H) / 26000);
    cells = Array.from({ length: Math.min(n, 90) }, () => ({
      x: Math.random() * W,
      y: Math.random() * H,
      vx: (Math.random() - 0.5) * 0.18,
      vy: (Math.random() - 0.5) * 0.18,
      r: 2 + Math.random() * 10,
      a: 0.05 + Math.random() * 0.1,
    }));
    bubbles = Array.from({ length: 18 }, () => ({
      x: W * (0.03 + Math.random() * 0.07),
      y: Math.random() * H,
      r: 1.3 + Math.random() * 3,
      v: 0.3 + Math.random() * 0.9,
    }));
  }

  function frame(t: number) {
    if (!ctx) return;
    ctx.clearRect(0, 0, W, H);

    // links between nearby cells
    ctx.strokeStyle = "rgba(90,235,175,0.05)";
    ctx.lineWidth = 1;
    for (let i = 0; i < cells.length; i++) {
      for (let j = i + 1; j < cells.length; j++) {
        const dx = cells[i].x - cells[j].x;
        const dy = cells[i].y - cells[j].y;
        const d2 = dx * dx + dy * dy;
        if (d2 < 15000) {
          ctx.globalAlpha = 1 - d2 / 15000;
          ctx.beginPath();
          ctx.moveTo(cells[i].x, cells[i].y);
          ctx.lineTo(cells[j].x, cells[j].y);
          ctx.stroke();
        }
      }
    }
    ctx.globalAlpha = 1;

    for (const c of cells) {
      c.x += c.vx;
      c.y += c.vy;
      if (c.x < -20) c.x = W + 20;
      if (c.x > W + 20) c.x = -20;
      if (c.y < -20) c.y = H + 20;
      if (c.y > H + 20) c.y = -20;
      const pulse = 1 + Math.sin(t * 0.0008 + c.x) * 0.08;
      ctx.beginPath();
      ctx.fillStyle = `rgba(90,235,175,${c.a})`;
      ctx.arc(c.x, c.y, c.r * pulse, 0, 6.2832);
      ctx.fill();
    }

    for (const b of bubbles) {
      b.y -= b.v;
      b.x += Math.sin(b.y * 0.03) * 0.25;
      if (b.y < -10) {
        b.y = H + 10;
        b.x = W * (0.03 + Math.random() * 0.07);
      }
      ctx.beginPath();
      ctx.fillStyle = "rgba(180,255,225,0.3)";
      ctx.arc(b.x, b.y, b.r, 0, 6.2832);
      ctx.fill();
    }

    if (running) requestAnimationFrame(frame);
  }

  function boot() {
    if (!cv || !ctx) return;
    size();
    seed();
    if (reduce) {
      frame(0);
      return;
    }
    if (!running) {
      running = true;
      requestAnimationFrame(frame);
    }
  }

  if (cv) {
    boot();
    let rt: ReturnType<typeof setTimeout>;
    addEventListener("resize", () => {
      clearTimeout(rt);
      rt = setTimeout(() => {
        size();
        seed();
        if (reduce) frame(0);
      }, 200);
    });
  }
</script>

<style>
  .hero {
    position: relative;
    background: var(--hero-bg);
    color: var(--hero-ink);
    overflow: hidden;
    isolation: isolate;
    min-height: clamp(560px, 86vh, 780px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: 64px;
  }
  .hero::before {
    content: "";
    position: absolute;
    inset: -20%;
    z-index: 0;
    background:
      radial-gradient(38% 40% at 22% 30%, rgba(28, 125, 85, 0.5), transparent 70%),
      radial-gradient(32% 38% at 78% 66%, rgba(20, 92, 66, 0.5), transparent 70%),
      radial-gradient(30% 30% at 60% 20%, rgba(60, 200, 150, 0.25), transparent 70%);
    filter: blur(60px);
    animation: mesh 28s var(--ease) infinite alternate;
  }
  @keyframes mesh {
    from {
      transform: translate3d(-3%, -2%, 0) scale(1);
    }
    to {
      transform: translate3d(4%, 3%, 0) scale(1.14);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero::before {
      animation: none;
    }
  }

  #hero-canvas {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    display: block;
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    padding-block: 3rem 3.5rem;
  }
  .eyebrow {
    color: var(--hero-mono);
    display: block;
    margin-bottom: 1.4rem;
  }
  .hero h1 {
    font-size: clamp(2.6rem, 7.5vw, 5.4rem);
    max-width: 15ch;
  }
  .lede {
    color: var(--hero-soft);
    font-size: clamp(1.05rem, 2vw, 1.3rem);
    max-width: 46ch;
    margin-top: 1.4rem;
  }
  .acro {
    color: var(--hero-mono);
    margin-top: 1rem;
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2rem;
  }
  .hero .btn-primary {
    background: var(--hero-particle);
    color: #05130d;
  }
  .hero .btn-ghost {
    border-color: rgba(159, 220, 196, 0.4);
    color: var(--hero-ink);
  }

  .scrollcue {
    position: absolute;
    left: 50%;
    bottom: 1.6rem;
    transform: translateX(-50%);
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    color: var(--hero-mono);
  }
  .scrollcue i {
    width: 1px;
    height: 34px;
    background: linear-gradient(var(--hero-mono), transparent);
    animation: cue 2s var(--ease) infinite;
  }
  @keyframes cue {
    0% {
      transform: scaleY(0);
      transform-origin: top;
    }
    45% {
      transform: scaleY(1);
      transform-origin: top;
    }
    55% {
      transform: scaleY(1);
      transform-origin: bottom;
    }
    100% {
      transform: scaleY(0);
      transform-origin: bottom;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .scrollcue i {
      animation: none;
    }
  }
</style>
