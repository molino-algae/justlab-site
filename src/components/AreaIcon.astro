---
/**
 * Line icon per research area. Draws itself in on scroll (see reveal.ts),
 * loops a small animation on hover. Stroke inherits `currentColor`.
 *
 * name: genetic-engineering | recombinant-proteins | bioprocess | biorefineries
 */
interface Props {
  name: string;
  class?: string;
}
const { name, class: className } = Astro.props;
---

<span class:list={["area-icon", `ai-${name}`, className]} data-reveal>
  {
    name === "genetic-engineering" && (
      <svg viewBox="0 0 32 32" aria-hidden="true">
        <g class="spin-slow">
          <path data-draw pathLength="1" d="M11 4c0 6 10 8 10 12s-10 6-10 12" />
          <path data-draw pathLength="1" d="M21 4c0 6-10 8-10 12s10 6 10 12" />
          <path data-draw pathLength="1" d="M12.5 8h7M11 12h10M11 20h10M12.5 24h7" />
        </g>
        <circle class="node" data-draw pathLength="1" cx="26" cy="16" r="2.4" />
      </svg>
    )
  }
  {
    name === "recombinant-proteins" && (
      <svg viewBox="0 0 32 32" aria-hidden="true">
        <circle data-draw pathLength="1" cx="13" cy="17" r="9" />
        <path data-draw pathLength="1" d="M13 17a4 4 0 0 1 8 0" />
        <g class="emit">
          <circle data-draw pathLength="1" cx="23" cy="9" r="2" />
          <path data-draw pathLength="1" d="M18 13l3-2" />
        </g>
      </svg>
    )
  }
  {
    name === "bioprocess" && (
      <svg viewBox="0 0 32 32" aria-hidden="true">
        <rect data-draw pathLength="1" x="8" y="5" width="16" height="22" rx="5" />
        <circle class="b b1" data-draw pathLength="1" cx="13" cy="20" r="1.4" />
        <circle class="b b2" data-draw pathLength="1" cx="18" cy="22" r="1.4" />
        <circle class="b b3" data-draw pathLength="1" cx="16" cy="16" r="1.4" />
      </svg>
    )
  }
  {
    name === "biorefineries" && (
      <svg viewBox="0 0 32 32" aria-hidden="true">
        <g class="spin">
          <path
            data-draw
            pathLength="1"
            d="M8 11a9 9 0 0 1 14 -2l3 2M24 21a9 9 0 0 1 -14 2l-3 -2"
          />
          <path data-draw pathLength="1" d="M25 6v5h-5M7 26v-5h5" />
        </g>
        <path class="leaf" data-draw pathLength="1" d="M16 13c-3 2-3 6 0 8 3-2 3-6 0-8Z" />
      </svg>
    )
  }
</span>

<style>
  .area-icon {
    display: inline-flex;
  }
  .area-icon svg {
    width: 40px;
    height: 40px;
    color: var(--accent);
    overflow: visible;
  }
  .area-icon :global(svg *) {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .area-icon :global(.node),
  .area-icon :global(.leaf),
  .area-icon :global(.b) {
    fill: color-mix(in oklab, var(--accent) 18%, transparent);
  }

  /* draw-on: hidden until [data-reveal] gets .in (reveal.ts / IntersectionObserver) */
  :global(html.js) .area-icon :global([data-draw]) {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 0.9s var(--ease);
  }
  :global(html.js) .area-icon.in :global([data-draw]) {
    stroke-dashoffset: 0;
  }

  /* hover loops — only after the icon has drawn in */
  .area-icon.in:hover :global(.spin) {
    animation: spin 3.4s linear infinite;
    transform-origin: 16px 16px;
  }
  .area-icon.in:hover :global(.spin-slow) {
    animation: spin 12s linear infinite;
    transform-origin: 16px 16px;
  }
  .area-icon.in:hover :global(.emit) {
    animation: emit 1.9s var(--ease) infinite;
  }
  .area-icon.in:hover :global(.b1) {
    animation: rise 1.8s var(--ease) infinite;
  }
  .area-icon.in:hover :global(.b2) {
    animation: rise 1.8s var(--ease) infinite 0.3s;
  }
  .area-icon.in:hover :global(.b3) {
    animation: rise 1.8s var(--ease) infinite 0.6s;
  }
  .area-icon.in:hover :global(.leaf) {
    animation: breathe 3s var(--ease) infinite;
    transform-origin: 16px 17px;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes emit {
    0% {
      transform: translate(0, 0);
      opacity: 0;
    }
    25% {
      opacity: 1;
    }
    100% {
      transform: translate(6px, -5px);
      opacity: 0;
    }
  }
  @keyframes rise {
    0% {
      transform: translateY(3px);
      opacity: 0;
    }
    30% {
      opacity: 1;
    }
    100% {
      transform: translateY(-7px);
      opacity: 0;
    }
  }
  @keyframes breathe {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.08);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .area-icon :global([data-draw]) {
      stroke-dashoffset: 0 !important;
      transition: none;
    }
    .area-icon.in:hover :global(*) {
      animation: none !important;
    }
  }
</style>
