---
import { site } from "../lib/data";
import Logo from "./Logo.astro";
const year = new Date().getFullYear();
---

<footer class="foot">
  <div class="wrap foot-grid">
    <div class="foot-brand">
      <Logo />
      <p>{site.description}</p>
      <p class="mono acro">{site.name} · {site.acronym}</p>
    </div>

    <div class="foot-col">
      <h4>Navigate</h4>
      {site.nav.map((i) => <a href={i.href}>{i.label}</a>)}
    </div>

    <div class="foot-col">
      <h4>Contact</h4>
      {site.address.lines.map((l: string) => <p>{l}</p>)}
      <a href={`mailto:${site.email}`}>{site.email}</a>
      {site.socials.github && <a href={site.socials.github}>GitHub</a>}
    </div>

    <div class="foot-col">
      <h4>Affiliations</h4>
      {site.affiliations.map((a) => <a href={a.url}>{a.short}</a>)}
    </div>
  </div>
  <div class="wrap foot-note mono">
    © {year} {site.name} · {site.department} · {site.institution}
  </div>
</footer>

<style>
  .foot {
    background: var(--surface-2);
    border-top: 1px solid var(--line);
    padding-block: var(--sect) 2rem;
  }
  .foot-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr;
    gap: 2.5rem;
  }
  @media (max-width: 820px) {
    .foot-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  .foot-brand p {
    color: var(--ink-soft);
    font-size: 0.92rem;
    max-width: 34ch;
    margin-top: 0.9rem;
  }
  .acro {
    color: var(--gold);
    margin-top: 0.6rem;
  }
  .foot-col h4 {
    font-family: var(--font-body);
    font-size: 0.95rem;
    margin-bottom: 0.7rem;
  }
  .foot-col a,
  .foot-col p {
    display: block;
    color: var(--ink-soft);
    text-decoration: none;
    font-size: 0.88rem;
    margin-bottom: 0.35rem;
  }
  .foot-col a:hover {
    color: var(--accent);
  }
  .foot-note {
    margin-top: 3rem;
    color: var(--ink-faint);
  }
</style>
